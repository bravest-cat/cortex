# ==============================================================================
# Cortex Configuration Environment Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ── Inference Endpoints & Models (Universal Hardware & Provider Support) ───────
# Cortex is 100% hardware-agnostic and provider-agnostic.
# Supported Backends:
#   - Apple Silicon (Metal): oMLX, MLX-LM, Ollama, LM Studio
#   - NVIDIA GPUs (CUDA): vLLM, Text Embeddings Inference (TEI), Ollama, LocalAI
#   - AMD GPUs (ROCm): vLLM, Ollama
#   - CPU / Cloud: llama.cpp, FastEmbed, OpenAI, Azure OpenAI, Groq, Together
#
# Embedding Server (OpenAI-compatible embedding endpoint)
EMBED_BASE_URL=http://localhost:8000/v1
EMBED_MODEL_NAME=mlx-community--Qwen3-Embedding-8B-4bit-DWQ
EMBED_DIMENSION=4096
EMBED_API_KEY=not-needed

# Cross-Encoder Reranker Server (Optional: oMLX, TEI, Cohere, or local cross-encoders)
# If unavailable, Cortex automatically and gracefully falls back to dense vector scoring.
RERANK_BASE_URL=http://localhost:8000/v1
RERANK_MODEL_NAME=mlx-community--Qwen3-Reranker-4B-4bit-MLX
RERANK_API_KEY=not-needed

# Direct LLM Completion Endpoint (Optional: for local reasoning or summarization)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=mlx-community--Qwen3-8B-Instruct-4bit
LLM_API_KEY=not-needed

# ── FalkorDB (Graph Database for AST Symbols & Episodic Knowledge) ────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_DATABASE=cortex
FALKORDB_SYMBOLS_GRAPH=cortex_symbols

# ── Qdrant (Vector Database for Dense Embeddings & Lexical Retrieval) ──────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cortex_codebase

# ── Cortex Web Dashboard ──────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8004

# ── Workspace & Journal Paths ─────────────────────────────────────────────────
# Comma-separated roots to index/watch. Defaults to the current working directory.
WORKSPACE_ROOTS=
JOURNAL_DIR=

# ── File Watcher & Synchronization Settings ───────────────────────────────────
CORTEX_WATCH_DEBOUNCE=2.0
