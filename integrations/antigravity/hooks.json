{
  "cortex-pre-invoke": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 <cortex_root>/scripts/hooks/hook_pre_invoke.py",
        "timeout": 5
      }
    ]
  },
  "cortex-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <cortex_root>/scripts/hooks/hook_pre_tool.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "cortex-hot-sync": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <cortex_root>/scripts/hooks/hook_post_tool.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "cortex-stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 <cortex_root>/scripts/hooks/hook_stop.py",
        "timeout": 10
      }
    ]
  }
}